{
  "compilerOptions": {
    "target": "ES2018",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "lib": [
      "es2015"
    ],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "incremental": true,
    "tsBuildInfoFile": "./.tmp/tsc.tsbuildinfo"
  },
  "exclude": [
    "remotion.config.ts",
    "node_modules",
    "scratch",
    "backups",
    "build",
    "public",
    "archive_public_unused",
    "render_work",
    "remotion_app_data",
    ".tmp"
  ],
  "include": [
    "src"
  ]
}
