  },
  "constraints": {
    "faces": "Preserve the features of the attached Dodo reference",
    "elbow": "Stable lower branch for raised-hand gestures",
    "speech": "Real voiced intervals in videos; silent demo uses sample intervals",
    "mother": "No visible mouth or hair outside the niqab"
  }
