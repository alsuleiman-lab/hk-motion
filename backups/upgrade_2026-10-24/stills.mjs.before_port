// Render several still frames of one composition (for checking scenes without a full render).
//   node tools/stills.mjs <CompositionId> <outDir> name:frame name:frame ... [--scale 0.5] [--manifest <file>] [--clean] [--legacy] [--jobs 1]
//
// 2026-10-22 (user order): NEVER copy the whole public/ folder. Remotion's bundle() copies publicDir into the bundle on every run (7 GB here, 1-2 min each time).
// New method:
//   1. the CODE is bundled with an EMPTY publicDir and the bundle is CACHED in .tmp/stills_bundle/<Id> (re-bundled only when src/** or package.json changed);
//   2. the ASSETS the project needs are HARD-LINKED (instant, no copy, same S: volume) into <bundle>/public with their relative paths unchanged, so staticFile("kh/x.png") still works.
//   Which assets? Automatically: Root.tsx -> the composition's component file -> every local import (recursively); each string / template literal in them that names a file
//   (or a folder prefix like `kh/alpha_${n}.webm`, `fonts/${f}`) and exists under public/ is linked. Add more with a manifest (one path or folder per line, relative to public/; # comments).
//   Originals are never touched; nothing is deleted except the cached bundle's own public/ links when you pass --clean.
//   --legacy = the old behaviour (bundle with the real public/), env PD=<dir> = bundle with that publicDir as-is.
import { bundle } from "@remotion/bundler";
import { openBrowser, renderStill, selectComposition } from "@remotion/renderer";
import path from "path"; import fs from "fs"; import crypto from "crypto";

const argv = process.argv.slice(2);
const flag = (n) => argv.includes("--" + n);
const opt = (n, d) => (flag(n) ? argv[argv.indexOf("--" + n) + 1] : d);
const valueFlags = new Set(["scale", "manifest", "jobs"]);
const pos = argv.filter((a, i) => !a.startsWith("--") && !(i > 0 && argv[i - 1].startsWith("--") && valueFlags.has(argv[i - 1].slice(2))));
const [id, outDir, ...pts] = pos;
if (!id || !outDir || !pts.length) { console.error("usage: node tools/stills.mjs <CompositionId> <outDir> name:frame ... [--scale 0.5] [--manifest file] [--clean] [--legacy]"); process.exit(2); }
fs.mkdirSync(outDir, { recursive: true });
const ROOT = process.cwd(), SRC = path.join(ROOT, "src"), PUB = path.join(ROOT, "public");
const ENTRY = path.resolve(process.env.ENTRY ?? "src/index.ts");
const scale = Number(opt("scale", "0.5"));

// ───────── which public/ files does this composition use? ─────────
const MEDIA = /\.(mp4|webm|mov|m4v|png|jpe?g|svg|gif|webp|avif|wav|mp3|m4a|ogg|ttf|otf|woff2?|json|txt|csv)$/i;
const readSrc = (f) => { try { return fs.readFileSync(f, "utf8"); } catch { return ""; } };
const resolveImport = (from, spec) => {
  const base = path.resolve(path.dirname(from), spec);
  for (const c of [base, base + ".tsx", base + ".ts", base + ".jsx", base + ".js", path.join(base, "index.tsx"), path.join(base, "index.ts")]) {
    try { if (fs.statSync(c).isFile()) return c; } catch { /* next */ }
  }
  return null;
};
function collectSources() {
  const rootFile = path.join(SRC, "Root.tsx");
  const root = readSrc(rootFile);
  const m = root.match(new RegExp(`id=["']${id.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")}["'][^>]*?component=\\{([A-Za-z0-9_]+)\\}`));
  const files = new Set([rootFile]);
  if (!m) { console.warn(`[stills] could not find <Composition id="${id}"> in src/Root.tsx; scanning src/ entirely`); for (const f of fs.readdirSync(SRC)) if (/\.(tsx?|jsx?)$/.test(f)) files.add(path.join(SRC, f)); return files; }
  const comp = m[1];
  const im = root.match(new RegExp(`import\\s*\\{[^}]*\\b${comp}\\b[^}]*\\}\\s*from\\s*["'](\\.[^"']+)["']`));
  const start = im ? resolveImport(rootFile, im[1]) : null;
  files.delete(rootFile);
  if (!start) { console.warn(`[stills] could not resolve the file of component ${comp}; scanning src/ entirely`); for (const f of fs.readdirSync(SRC)) if (/\.(tsx?|jsx?)$/.test(f)) files.add(path.join(SRC, f)); return files; }
  const stack = [start];
  while (stack.length) {
    const f = stack.pop();
    if (files.has(f)) continue;
    files.add(f);
    for (const x of readSrc(f).matchAll(/(?:from\s+|import\s*\(\s*|import\s+)["'](\.[^"']+)["']/g)) { const r = resolveImport(f, x[1]); if (r && !files.has(r)) stack.push(r); }
  }
  return files;
}
const walk = (dir) => { const out = []; for (const e of fs.readdirSync(dir, { withFileTypes: true })) { const p = path.join(dir, e.name); if (e.isDirectory()) out.push(...walk(p)); else out.push(p); } return out; };
function neededAssets() {
  const rel = new Set();
  const add = (p) => { // p relative to public/ (file or folder)
    const abs = path.join(PUB, p);
    try { const st = fs.statSync(abs); if (st.isDirectory()) for (const f of walk(abs)) rel.add(path.relative(PUB, f).replace(/\\/g, "/")); else rel.add(p.replace(/\\/g, "/")); } catch { /* not a public path */ }
  };
  let allPub = null;
  const prefix = (pre) => { // `kh/alpha_${n}.webm` -> every public file whose path starts with "kh/alpha_"
    allPub ??= walk(PUB).map((f) => path.relative(PUB, f).replace(/\\/g, "/"));
    for (const f of allPub) if (f.startsWith(pre)) rel.add(f);
  };
  for (const f of collectSources()) {
    const t = readSrc(f);
    for (const m of t.matchAll(/["'`]([^"'`\n$]+?)(\$\{|["'`])/g)) {
      const s = m[1].replace(/^\/+/, "").replace(/^\.\.\/public\//, "");
      if (m[2] === "${") { if (s.includes("/") && s.length > 2) prefix(s); continue; }
      if (MEDIA.test(s) || /\/$/.test(s)) add(s);
    }
  }
  const mf = opt("manifest", process.env.STILLS_MANIFEST ?? "");
  if (mf) for (const line of readSrc(mf).split(/\r?\n/)) { const l = line.replace(/#.*/, "").trim(); if (l) add(l.replace(/^public[\\/]/, "")); }
  return [...rel].sort();
}
function linkInto(destPublic, files) {
  let linked = 0, copied = 0, bytes = 0;
  for (const f of files) {
    const from = path.join(PUB, f), to = path.join(destPublic, f);
    if (fs.existsSync(to)) continue;
    fs.mkdirSync(path.dirname(to), { recursive: true });
    try { fs.linkSync(from, to); linked++; } catch { fs.copyFileSync(from, to); copied++; }
    bytes += fs.statSync(from).size;
  }
  return { linked, copied, mb: Math.round(bytes / 1048576) };
}

// ───────── bundle (cached) ─────────
let serveUrl, cacheDir = null;
if (flag("legacy") || process.env.PD) {
  serveUrl = await bundle({ entryPoint: ENTRY, publicDir: process.env.PD ? path.resolve(process.env.PD) : undefined, onProgress: () => {} });
} else {
  cacheDir = path.join(ROOT, ".tmp", "stills_bundle", id);
  const emptyPub = path.join(ROOT, ".tmp", "stills_empty_public"); fs.mkdirSync(emptyPub, { recursive: true });
  const h = crypto.createHash("sha1");
  for (const f of walk(SRC).sort()) { const st = fs.statSync(f); h.update(`${path.relative(ROOT, f)}|${st.size}|${Math.round(st.mtimeMs)}\n`); }
  for (const f of ["package.json", "tsconfig.json", "remotion.config.ts"]) { try { const st = fs.statSync(path.join(ROOT, f)); h.update(`${f}|${st.size}|${Math.round(st.mtimeMs)}\n`); } catch { /* optional */ } }
  const stamp = h.digest("hex"), stampFile = path.join(cacheDir, ".stills_stamp");
  const fresh = fs.existsSync(stampFile) && readSrc(stampFile) === stamp && fs.existsSync(path.join(cacheDir, "index.html"));
  if (fresh) console.log("[stills] bundle reused (code unchanged)");
  else {
    fs.rmSync(cacheDir, { recursive: true, force: true });
    fs.mkdirSync(path.dirname(cacheDir), { recursive: true });
    await bundle({ entryPoint: ENTRY, publicDir: emptyPub, outDir: cacheDir, onProgress: () => {} });
    fs.writeFileSync(stampFile, stamp);
    console.log("[stills] bundle built");
  }
  serveUrl = cacheDir;
  const need = neededAssets();
  const r = linkInto(path.join(cacheDir, "public"), need);
  console.log(`[stills] assets: ${need.length} files (${r.linked} hard-linked, ${r.copied} copied, ${r.mb} MB) — not the whole public/`);
}

// SPEED (2026-10-22, from the official Remotion skills: one call for many frames): ONE shared headless browser for every still (no launch per frame) and the frames are rendered
// sequentially by default (--jobs N or env STILLS_JOBS for parallel: MEASURED slower here — 3 workers 12.2-13.0 s vs 1 worker 9.4-9.7 s for 6 stills, GPU/CPU contention). Output names/format are unchanged.
const browser = await openBrowser("chrome", { chromiumOptions: { gl: "angle" }, logLevel: "error" });
const comp = await selectComposition({ serveUrl, id, puppeteerInstance: browser });
const jobs = Math.max(1, Math.min(pts.length, Number(opt("jobs", process.env.STILLS_JOBS ?? "1"))));
let next = 0;
await Promise.all(Array.from({ length: jobs }, async () => {
  while (next < pts.length) {
    const p = pts[next++];
    const [name, fr] = p.split(":");
    await renderStill({ composition: comp, serveUrl, frame: Number(fr), output: path.join(outDir, name + ".png"), scale, puppeteerInstance: browser, timeoutInMilliseconds: Number(process.env.RT || 30000), chromiumOptions: { gl: "angle" } });
    console.log("still", name);
  }
}));
await browser.close({ silent: true });
if (flag("clean") && cacheDir) fs.rmSync(path.join(cacheDir, "public"), { recursive: true, force: true });
if (!cacheDir) { try { fs.rmSync(serveUrl, { recursive: true, force: true }); } catch { /* ignore */ } }
