/** a time-bounded layer: children get r(t) = seconds relative to the layer start */
const BaseCtx = React.createContext(0);
const S: React.FC<{ a: number; b: number; children: (r: (t: number) => number) => React.ReactNode }> = ({ a, b, children }) => {
  const base = React.useContext(BaseCtx);
  return (
    <Sequence from={sec(a) - sec(base)} durationInFrames={Math.max(1, sec(b) - sec(a))} layout="none">
      <BaseCtx.Provider value={a}>{children((t) => t - a)}</BaseCtx.Provider>
    </Sequence>
  );
};

